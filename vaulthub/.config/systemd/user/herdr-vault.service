[Unit]
Description=herdr headless server for the Obsidian vault hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=%h/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/herdr server
ExecStartPost=%h/bin/vault-hub-ensure-pane
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
